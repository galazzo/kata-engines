+float speech_speed(const Value &body) {
+  const auto *value = body.find("speed");
+  if (value == nullptr) {
+    value = body.find("speaking_rate");
+  }
+  if (value == nullptr) {
+    return 1.0F;
+  }
+  const double parsed = value->as_number();
+  if (!std::isfinite(parsed) || parsed < 0.5 || parsed > 2.0) {
+    throw engine::runtime::InvalidRequestError(
+        "speed must be a finite number between 0.5 and 2.0");
+  }
+  return static_cast<float>(parsed);
+}
+
+engine::runtime::AudioBuffer
+apply_speech_speed(const engine::runtime::AudioBuffer &audio, float speed) {
+  if (!std::isfinite(speed) || speed < 0.5F || speed > 2.0F) {
+    throw engine::runtime::InvalidRequestError(
+        "speed must be a finite number between 0.5 and 2.0");
+  }
+  if (speed == 1.0F) {
+    return audio;
+  }
+  if (audio.sample_rate <= 0 || audio.channels <= 0 ||
+      audio.samples.size() % static_cast<size_t>(audio.channels) != 0) {
+    throw std::runtime_error("speech speed requires valid interleaved audio");
+  }
+
+  const size_t frames =
+      audio.samples.size() / static_cast<size_t>(audio.channels);
+  std::vector<std::vector<float>> channels(
+      static_cast<size_t>(audio.channels), std::vector<float>(frames));
+  for (size_t frame = 0; frame < frames; ++frame) {
+    for (int channel = 0; channel < audio.channels; ++channel) {
+      channels[static_cast<size_t>(channel)][frame] =
+          audio.samples[frame * static_cast<size_t>(audio.channels) +
+                        static_cast<size_t>(channel)];
+    }
+  }
+
+  size_t output_frames = 0;
+  for (auto &channel : channels) {
+    minitts::app::StreamingSpeechTempo tempo(audio.sample_rate, speed);
+    channel = tempo.process(channel, true);
+    output_frames = std::max(output_frames, channel.size());
+  }
+  engine::runtime::AudioBuffer result{
+      audio.sample_rate, audio.channels, std::vector<float>()};
+  result.samples.reserve(output_frames * static_cast<size_t>(audio.channels));
+  for (size_t frame = 0; frame < output_frames; ++frame) {
+    for (int channel = 0; channel < audio.channels; ++channel) {
+      const auto &samples = channels[static_cast<size_t>(channel)];
+      result.samples.push_back(frame < samples.size() ? samples[frame] : 0.0F);
+    }
+  }
+  return result;
+}
